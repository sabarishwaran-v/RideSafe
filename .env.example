# ==============================================================================
# RideSafe Backend - Environment Configuration Template
# Copy this file to '.env' for local development. Do NOT commit real secrets.
# ==============================================================================

# Application Settings
APP_NAME="RideSafe Backend"
APP_ENV=development
DEBUG=false
HOST=0.0.0.0
PORT=8000
API_PREFIX=/api/ridesafe

# Database Configuration (SQLite)
DATABASE_PATH=data/ridesafe.db

# API Security
# Shared secret required in 'X-API-Key' header on /api/ridesafe/alert and /api/ridesafe/test
RIDESAFE_API_KEY=ridesafe_secret_key_change_me

# Twilio WhatsApp Credentials
# Sign up at https://console.twilio.com/ to retrieve your Account SID and Auth Token
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here

# Twilio WhatsApp Sender Number
# Check your console: Messaging > Try it out > Send a WhatsApp message
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Emergency Recipient WhatsApp Number (E.164 format with country code and 'whatsapp:' prefix)
# In sandbox mode, this number MUST first send "join <sandbox-keyword>" to the sender above.
EMERGENCY_WHATSAPP_TO=whatsapp:+919876543210

# Twilio Content Template SID (HX...)
# Required if Twilio returns Error 21654 ("Unable to create record: ContentSid Required").
# Meta/Twilio WhatsApp policy requires business-initiated outbound messages to use pre-approved templates.
# How to obtain in Twilio Console:
# 1. Messaging > Try it out > Send a WhatsApp message:
#    Look at the code sample tab (Python/cURL). Twilio displays the pre-configured Sandbox template SID (e.g. HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx).
# 2. OR Messaging > Content Template Builder:
#    Create a custom WhatsApp template (e.g. "ridesafe_alert") and copy its 'HX...' Content SID.
TWILIO_CONTENT_SID=HXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Optional: Dedicated Content SID for the /test endpoint (defaults to TWILIO_CONTENT_SID if omitted)
# TWILIO_TEST_CONTENT_SID=HXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Optional: Custom JSON variable mapping for Content Templates.
# Available placeholder tokens: {event}, {device_id}, {event_id}, {timestamp}, {telemetry}, {location}, {speed}, {tilt}, {message}
# Default if omitted: {"1": "{event}", "2": "{device_id}", "3": "{timestamp}", "4": "{telemetry}", "5": "{location}"}
# For 2-variable Sandbox Quickstart templates: {"1": "{device_id}", "2": "{event_id}"}
# TWILIO_CONTENT_VARIABLES='{"1": "{event}", "2": "{device_id}", "3": "{timestamp}", "4": "{telemetry}", "5": "{location}"}'
